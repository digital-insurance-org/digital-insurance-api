# OpenAI, used by the reply draft helper (src/ai/reply-draft.agent.ts).
# OPENAI_BASE_URL points the client at the APISynQ gateway rather than
# api.openai.com, so the call is recorded and the data-class policy is applied:
#   OPENAI_BASE_URL=https://governance-api.apisynq.com/v1/ai-gw/openai/v1
OPENAI_BASE_URL=https://governance-api.apisynq.com/v1/ai-gw/openai/v1
OPENAI_API_KEY=replace-me
